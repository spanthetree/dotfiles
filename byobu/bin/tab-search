#!/bin/sh
# Alt-d popup: fuzzy-find a tab. Empty query lists the tabs; typing also searches their panes' text (scrollback
# included). Picking a text line jumps to that tab and pane and scrolls to the line in copy mode.
t=$(printf '\t')
if [ "$1" = --list ]; then  # fzf reloads this on every keystroke; $2 is the query
  # fields: tab, pane, name shown on text lines (not searched), searched text (tab rows: name + folder)
  tmux list-windows -F "#{window_index}$t#{pane_id}$t$t#{window_name}  #{pane_current_path}"
  [ -n "$2" ] || exit 0
  tmux list-panes -s -F "#{window_index}$t#{pane_id}$t#{window_name}" | while IFS="$t" read -r w p n; do
    tmux capture-pane -p -J -S - -t "$p" | awk -v pre="$w$t$p$t$n$t" '{sub(/[ \t]+$/, "")} NF {print pre $0}'
  done
  exit 0
fi
sel=$("$0" --list | fzf --exact --reverse --prompt='tab> ' --delimiter="$t" --with-nth=1,3,4 --nth=3 --tiebreak=index \
  --bind "change:reload:'$0' --list {q}" --bind 'alt-d:abort')  # Alt-d again closes it
[ -n "$sel" ] || exit 0
# cut, not read: read merges the empty field between consecutive tabs
w=$(printf '%s' "$sel" | cut -f1); p=$(printf '%s' "$sel" | cut -f2); n=$(printf '%s' "$sel" | cut -f3); line=$(printf '%s' "$sel" | cut -f4-)
tmux select-window -t ":$w" \; select-pane -t "$p"
[ -z "$n" ] || tmux copy-mode -t "$p" \; send-keys -t "$p" -X search-backward-text "$line"
