[Desktop Entry]
# pivot, the Alt-Tab switcher with window previews under COSMIC (packages.yaml; bound in linux/cosmic/shortcuts.ron).
# Started at login so it knows the most recently used order from the start. Linked to
# ~/.config/autostart/dotfiles-pivot.desktop; COSMIC only. Without --ensure-shortcuts: our shortcuts file binds the keys.
Type=Application
Name=pivot (dotfiles)
Exec=sh -c "exec ~/.local/bin/pivot daemon"
NoDisplay=true
OnlyShowIn=COSMIC;
X-COSMIC-Autostart-enabled=true
