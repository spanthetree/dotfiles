# ~/.zprofile: login shells, before ~/.zshrc.

export EDITOR=vim
export VISUAL=vim
export PAGER=less
[[ -z "$LANG" ]] && export LANG=en_US.UTF-8

# -F quit if one screen, -R colors, -S chop long lines, -X keep screen, -i smart case
export LESS='-F -g -i -M -R -S -w -X -z-4'
if (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

# Auto-start byobu. Opt out per machine: touch ~/.config/byobu/disable-autolaunch
# Skipped inside tmux: byobu tabs are login shells too, and the launcher would nest or exit
[[ -z $TMUX ]] && { _byobu_sourced=1 . /usr/bin/byobu-launch 2>/dev/null || true; }

# The Hyprland desktop setup's copy.sh appends "source /etc/profile" (for flatpak paths on Debian) unless this file
# already mentions it, as this line does. Not needed here: on Ubuntu the login session already sets those paths, and
# it would run /etc/profile.d's sh scripts (byobu's launcher among them) a second time under zsh.
