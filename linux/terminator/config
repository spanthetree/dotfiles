# Terminator: SynthWave '84, matching Windows Terminal (windows/terminal/settings.patch.json)
# Old and new option names both: Terminator ignores the ones it doesn't know (2.1.3 on Ubuntu 24.04 uses cursor_color
# and global title_hide_sizetext; 2.1.5 on 26.04 uses cursor_bg_color + cursor_color_default and the profile's).
# Saving its preferences rewrites this file (through the link) without the comments and the unknown names.
[global_config]
  title_hide_sizetext = True
[keybindings]
[profiles]
  [[default]]
    # login shell, so ~/.zprofile runs and byobu auto-starts
    login_shell = True
    use_system_font = False
    font = JetBrainsMono Nerd Font 11
    background_color = "#111018"
    foreground_color = "#ffffff"
    cursor_color = "#36f9f6"
    cursor_color_fg = False
    cursor_bg_color = "#36f9f6"
    cursor_color_default = False
    title_hide_sizetext = True
    background_type = transparent
    background_darkness = 0.95
    scrollbar_position = hidden
    show_titlebar = False
    palette = "#000000:#fe4450:#72f1b8:#fede5d:#36f9f6:#ff7edb:#36f9f6:#f8f8f2:#6a5a7a:#ff6e76:#a5f7ce:#fff3a3:#80ffff:#ffa6e8:#9affff:#ffffff"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
