# Terminator: SynthWave '84, matching Windows Terminal (windows/terminal/settings.patch.json)
[global_config]
  title_hide_sizetext = True
[keybindings]
[profiles]
  [[default]]
    # login shell, so ~/.zprofile runs and byobu auto-starts
    login_shell = True
    use_system_font = False
    font = JetBrainsMono Nerd Font 11
    background_color = "#111018"
    foreground_color = "#ffffff"
    cursor_color = "#36f9f6"
    cursor_color_fg = False
    background_type = transparent
    background_darkness = 0.95
    scrollbar_position = hidden
    show_titlebar = False
    palette = "#000000:#fe4450:#72f1b8:#fede5d:#36f9f6:#ff7edb:#36f9f6:#f8f8f2:#6a5a7a:#ff6e76:#a5f7ce:#fff3a3:#80ffff:#ffa6e8:#9affff:#ffffff"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
