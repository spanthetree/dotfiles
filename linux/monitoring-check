#!/usr/bin/env bash
# monitoring-check: software on this machine that could let someone else see private data stored or shown on it.
# Prints one line per finding (nothing on a machine with none). Two kinds:
#   - it can read local files: endpoint security (EDR), data loss prevention, file-query and forensics agents. Beeper,
#     for one, keeps its chats decrypted in a local SQLite database;
#   - it can record the screen: activity and screen monitoring.
# Read-only: it only looks for install folders and running processes. packages.py runs it before installing an entry
# with `private:` (e.g. Beeper), and asks first when it finds anything.
# Not listed: what only sees network traffic (VPNs, Zscaler, Netskope, company root certificates) or manages the
# device (MDM, directory joins, config management). End-to-end encryption keeps messages from those; what they deploy
# shows up here once installed. Nothing found is no proof of privacy: an agent can be hidden, or added later.
set -uo pipefail
procs=$(ps -eo args= 2>/dev/null | awk '{print $1}')   # each process's program, not its arguments
found() { printf '%s\n' "$1"; }
has_dir() { local d; for d; do [[ -e $d ]] && return 0; done; return 1; }
has_proc() { grep -qiE "$1" <<<"$procs"; }

# name | what it is | install folders (any) | process regex (optional)
while IFS='|' read -r name what dirs re; do
  [[ -z $name || $name == \#* ]] && continue
  # shellcheck disable=SC2086  # dirs: a space-separated list
  if { [[ -n $dirs ]] && has_dir $dirs; } || { [[ -n $re ]] && has_proc "$re"; }; then found "$name ($what)"; fi
done <<'EOF'
